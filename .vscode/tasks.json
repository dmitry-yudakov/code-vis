// Default tasks target the root CodeAI application. See legacy/README.md for the archived runtime.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CodeAI: dev server",
      "type": "npm",
      "script": "dev",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always" },
      "group": { "kind": "build", "isDefault": true }
    },
    { "label": "CodeAI: build", "type": "npm", "script": "build", "problemMatcher": ["$tsc"], "group": "build" },
    { "label": "CodeAI: lint (tsc)", "type": "npm", "script": "lint", "problemMatcher": ["$tsc"], "group": "build" },
    {
      "label": "CodeAI: test",
      "type": "npm",
      "script": "test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    { "label": "CodeAI: test (watch)", "type": "npm", "script": "test:watch", "problemMatcher": [], "isBackground": true, "group": "test" },
    { "label": "CodeAI: e2e", "type": "npm", "script": "test:e2e", "problemMatcher": [], "group": "test" }
  ]
}
