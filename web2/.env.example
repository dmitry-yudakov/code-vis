# One project, or a directory whose immediate children are projects.
CODEAI_WEB2_PROJECTS_ROOT=/absolute/path/to/projects
CODEAI_WEB2_PROJECTS_DEPTH=1

# Optional local-agent settings. Do not put credentials here.
CODEAI_WEB2_CLAUDE_BIN=claude
CODEAI_WEB2_CLAUDE_MODEL=
CODEAI_WEB2_CODEX_BIN=codex
CODEAI_WEB2_CODEX_MODEL=
# Codex Ask/Plan are enabled after preflight. Leave this unset unless the installed App Server has
# passed the real Agent approval-parity matrix in docs/experiment-log.md.
CODEAI_WEB2_CODEX_AGENT=
# Budget for one Ask/Plan message.
CODEAI_WEB2_AGENT_TIMEOUT_MS=900000
CODEAI_WEB2_AGENT_MAX_TURNS=20
# Budget for one Agent message. Building spends turns on research long before the first edit, so
# these are much larger. Time spent waiting on approval does not count against the timeout.
CODEAI_WEB2_BUILD_TIMEOUT_MS=3600000
CODEAI_WEB2_BUILD_MAX_TURNS=200
# How long an agent-mode permission card may wait before it is auto-denied.
CODEAI_WEB2_APPROVAL_TIMEOUT_MS=600000
CODEAI_WEB2_DATA_DIR=~/.code-ai/web2
CODEAI_WEB2_MAX_ASSISTANT_BYTES=1048576
CODEAI_WEB2_MAX_MERMAID_BYTES=100000
CODEAI_WEB2_MAX_DIAGRAMS_PER_MESSAGE=8
CODEAI_WEB2_MAX_DIAGRAM_ATTACHMENTS=4
CODEAI_WEB2_MAX_ATTACHMENT_BYTES=4194304
CODEAI_WEB2_MAX_GIT_CONTEXT_BYTES=524288
# Bounded historical handoff context after browser-side wire windowing.
CODEAI_WEB2_MAX_TRANSCRIPT_MESSAGES=40
CODEAI_WEB2_MAX_TRANSCRIPT_BYTES=24000

# Set to 1 to print compact per-run agent stream logs to the server console.
CODEAI_WEB2_DEBUG_AGENT=
