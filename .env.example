# One repository, or a directory whose descendants contain repositories.
CODEAI_REPOSITORIES_ROOT=/absolute/path/to/repositories
CODEAI_REPOSITORIES_DEPTH=1

# Optional local-agent settings. Do not put credentials here.
CODEAI_CLAUDE_BIN=claude
CODEAI_CLAUDE_MODEL=
CODEAI_CODEX_BIN=codex
CODEAI_CODEX_MODEL=
# Codex Ask/Plan are enabled after preflight. Leave this unset unless the installed App Server has
# passed the real Agent approval-parity matrix in docs/experiment-log.md.
CODEAI_CODEX_AGENT=
# Budget for one Ask/Plan message.
CODEAI_AGENT_TIMEOUT_MS=900000
CODEAI_AGENT_MAX_TURNS=20
# Budget for one Agent message. Building spends turns on research long before the first edit, so
# these are much larger. Time spent waiting on approval does not count against the timeout.
CODEAI_BUILD_TIMEOUT_MS=3600000
CODEAI_BUILD_MAX_TURNS=200
# How long an agent-mode permission card may wait before it is auto-denied.
CODEAI_APPROVAL_TIMEOUT_MS=600000
# Maximum provider turns this machine executes at once. Additional accepted turns queue in memory.
CODEAI_MAX_CONCURRENT_RUNS=2
# Canonical host-owned conversations. The default directory name keeps its historical `web2`
# spelling. session-store-v2 contains durable projects and sessions.
CODEAI_DATA_DIR=~/.code-ai/web2
# Persisted only when the host store is first created. Later environment changes do not
# rename that store's host identity. Defaults to the machine hostname.
CODEAI_HOST_LABEL=
CODEAI_MAX_ASSISTANT_BYTES=1048576
CODEAI_MAX_MERMAID_BYTES=100000
CODEAI_MAX_DIAGRAMS_PER_MESSAGE=8
CODEAI_MAX_DIAGRAM_ATTACHMENTS=4
CODEAI_MAX_ATTACHMENT_BYTES=4194304
CODEAI_MAX_GIT_CONTEXT_BYTES=524288
# Bounded historical handoff context built from the canonical host transcript.
CODEAI_MAX_TRANSCRIPT_MESSAGES=40
CODEAI_MAX_TRANSCRIPT_BYTES=24000

# Set to 1 to print compact per-run agent stream logs to the server console.
CODEAI_DEBUG_AGENT=

# Migration note: every variable above also accepts its former `CODEAI_WEB2_*` spelling
# (for example CODEAI_WEB2_REPOSITORIES_ROOT). CODEAI_PROJECTS_ROOT and CODEAI_PROJECTS_DEPTH
# remain accepted compatibility fallbacks for repository discovery.
