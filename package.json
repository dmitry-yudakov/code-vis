{
  "name": "code-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3023",
    "build": "next build",
    "start": "next start -p 3023",
    "start:remote": "NODE_ENV=production node scripts/start-remote.mjs",
    "device:pair": "tsx scripts/create-pairing-code.ts",
    "lint": "tsc --noEmit",
    "tokens": "tsx scripts/generate-tokens.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "CODEAI_DIST_DIR=.next-e2e npm run build && CODEAI_DIST_DIR=.next-e2e playwright test"
  },
  "dependencies": {
    "mermaid": "^11.12.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
